<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/car_list_fragment">

    <fragment
        android:id="@+id/car_list_fragment"
        android:name="com.example.trabajointegrador_modulonativo.carListFragment"
        android:label="carListFragment">
        <action
            android:id="@+id/show_car_detail"
            app:destination="@id/car_detail_fragment" />
        <action
            android:id="@+id/action_carListFragment_to_createCarFragment"
            app:destination="@id/createCarFragment" />
    </fragment>
    <fragment
        android:id="@+id/car_detail_fragment"
        android:name="com.example.trabajointegrador_modulonativo.carDetailFragment"
        android:label="car_detail"
        tools:layout="@layout/fragment_car_detail">
        <argument
            android:name="item_id"
            android:defaultValue=""
            app:argType="string" />
    </fragment>
    <fragment
        android:id="@+id/createCarFragment"
        android:name="com.example.trabajointegrador_modulonativo.create_car"
        android:label="Creacion de auto" />

</navigation>