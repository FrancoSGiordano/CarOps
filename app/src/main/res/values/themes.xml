<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.TrabajoIntegradorModuloNativo" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <item name="android:windowBackground">@color/primary</item>
        <item name="android:colorBackground">@color/primary</item>
        <item name="android:statusBarColor">@color/card_background</item>
        <item name="android:navigationBarColor">@color/card_background</item>
    </style>

    <style name="Theme.TrabajoIntegradorModuloNativo" parent="Base.Theme.TrabajoIntegradorModuloNativo" />

    <style name="Theme.TrabajoIntegradorModuloNativo.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.TrabajoIntegradorModuloNativo.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.TrabajoIntegradorModuloNativo.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />

    <style name="SpinnerItemStyle" parent="Widget.AppCompat.TextView.SpinnerItem">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="CustomAlertDialogTheme" parent="Theme.Material3.Dark.Dialog.Alert">

        <!-- Color de fondo del diálogo. Usa el mismo color oscuro que el resto de tu app.
             Puedes cambiarlo por tu color de fondo principal si es diferente. -->
        <item name="colorSurface">@color/primary</item> <!-- O el color de fondo de tu app -->

        <!-- Color del Título ("Selecciona un Tipo de Gasto") -->
        <item name="android:textColorPrimary">@color/white</item>

        <!-- Color del texto de los ítems de la lista ("Combustible", "Mantenimiento", etc.) -->
        <item name="android:textColor">@color/white</item>

        <!-- Color del botón "Cancelar".
             Aquí podemos usar tu color de acento o un gris claro para diferenciarlo. -->
        <item name="colorOnSurface">@color/gray_light</item>

    </style>

    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.MaterialComponents.Subtitle2">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">true</item> <!-- Para que el texto siempre esté en mayúsculas -->
    </style>

    <style name="TextAppearance.App.CardTitle" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.App.CardDetail" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textColor">@color/gray_light</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>