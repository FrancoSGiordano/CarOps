<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/car_detail_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".carDetailHostActivity"
    tools:ignore="MergeRootFrame">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">


            <ImageView
                android:id="@+id/carImageView"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:layout_marginTop="30dp"
                android:layout_marginHorizontal="60dp"
                app:srcCompat="@drawable/generic_car_icon" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="30dp"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:paddingVertical="8dp"
                android:background="@drawable/container_border_background"
                android:weightSum="2">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/viewParkingButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="Estacionar"
                        android:textColor="@color/gray_light"
                        app:icon="@drawable/parking_icon"
                        app:iconGravity="top"
                        app:iconSize="32dp"
                        app:iconTint="@color/button"
                         />


                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/remindersButton"
                        style="@style/Widget.MaterialComponents.Button.TextButton.Icon"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:paddingVertical="8dp"
                        android:text="Recordatorios"
                        android:textColor="@color/gray_light"
                        app:icon="@drawable/reminder_icon"
                        app:iconGravity="top"
                        app:iconSize="32dp"
                        app:iconTint="@color/button"
                        />


                </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="30dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="30dp"
                android:background="@drawable/container_border_background"
                android:orientation="vertical"
                android:padding="16dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >
                    <TextView
                        android:id="@+id/carData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/TextAppearance.App.SectionTitle"
                        android:background="@drawable/title_chip_background"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="4dp"
                        android:text="DATOS DEL VEHICULO"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"

                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <ImageButton
                        android:id="@+id/editCarDataButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:contentDescription="Editar datos del vehículo"
                        android:padding="8dp"
                        app:srcCompat="@drawable/edit_icon"
                        app:tint="@android:color/darker_gray"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>


                <TextView
                    android:id="@+id/lastModifiedTextView"
                    style="@style/TextAppearance.App.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Ultima actualizacion: "
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/plateTextView"
                    style="@style/TextAppearance.App.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Patente: "
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/carBrandTextView"
                    style="@style/TextAppearance.App.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Marca: "
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/carModelTextView"
                    style="@style/TextAppearance.App.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Modelo: "
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/carYearTextView"
                    style="@style/TextAppearance.App.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Año:"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/carEngineTextView"
                    style="@style/TextAppearance.App.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Motor:"
                    android:textColor="@android:color/darker_gray" />

                <TextView
                    android:id="@+id/carTransmissionTextView"
                    style="@style/TextAppearance.App.CardTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Transmision: "
                    android:textColor="@android:color/darker_gray" />



            </LinearLayout>

            <LinearLayout
                android:id="@+id/insuranceDataContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="30dp"
                android:background="@drawable/container_border_background"
                android:orientation="vertical"
                android:padding="16dp"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/insuranceData"
                        style="@style/TextAppearance.App.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/title_chip_background"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="4dp"
                        android:text="SEGURO"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"

                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                    <LinearLayout
                        android:id="@+id/insuranceButtonsContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageButton
                            android:id="@+id/showCirculationCardButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:contentDescription="Ver la tarjeta de circulacion"
                            android:padding="8dp"
                            app:srcCompat="@drawable/doc_icon"
                            app:tint="@android:color/darker_gray" />

                        <ImageButton
                            android:id="@+id/editInsuranceDataButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:contentDescription="Editar datos del vehículo"
                            android:padding="8dp"
                            app:srcCompat="@drawable/edit_icon"
                            app:tint="@android:color/darker_gray" />

                    </LinearLayout>



                </androidx.constraintlayout.widget.ConstraintLayout>

                <LinearLayout
                    android:id="@+id/insuranceDetailsContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:id="@+id/lastModifiedInsuranceTextView"
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Ultima actualizacion: "
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/insuranceNameTextView"
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Aseguradora: "
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/policyNumberTextView"
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Numero de poliza: "
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/expirationDateTextView"
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Fecha de vencimiento: "
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/coverageTypeTextView"
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Tipo de cobertura:"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/ownerNameTextView"
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Titular:"
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/engineNumberTextView"
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Numero de motor: "
                        android:textColor="@android:color/darker_gray" />

                    <TextView
                        android:id="@+id/chassisNumberTextView"
                        style="@style/TextAppearance.App.CardTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="Numero de chasis: "
                        android:textColor="@android:color/darker_gray" />


                </LinearLayout>





                <LinearLayout
                    android:id="@+id/addInsuranceContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:layout_marginTop="30dp"
                    android:layout_marginEnd="30dp"
                    android:background="@drawable/container_border_background"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="32dp"
                    android:visibility="gone"
                    tools:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Este vehículo no tiene un seguro asociado."
                        android:textAlignment="center"
                        android:textColor="@android:color/darker_gray"
                        android:textSize="16sp" />

                    <Button
                        android:id="@+id/btnAddInsurance"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="Agregar seguro"
                        app:backgroundTint="@color/button" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/expensesDataContainer"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="30dp"
                android:layout_marginTop="30dp"
                android:background="@drawable/container_border_background"
                android:orientation="vertical"
                android:padding="16dp"
                >

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/expensesData"
                        style="@style/TextAppearance.App.SectionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/title_chip_background"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="4dp"
                        android:text="GASTOS"
                        android:textColor="@android:color/white"
                        android:textSize="14sp"

                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent">

                        <ImageButton
                            android:id="@+id/addExpensesButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:contentDescription="Añadir un gasto del vehiculo"
                            android:padding="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/add_icon"
                            app:tint="@android:color/darker_gray" />

                        <ImageButton
                            android:id="@+id/showExpensesButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:contentDescription="Ver los gastos del vehiculo"
                            android:padding="8dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/list_icon"
                            app:tint="@android:color/darker_gray" />


                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/expensesRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    tools:listitem="@layout/car_expense_item"
                    tools:itemCount="3"
                    android:visibility="gone"
                    tools:visibility="visible"/>


                    <LinearLayout
                        android:id="@+id/noExpensesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:visibility="gone"
                        tools:visibility="gone">

                        <TextView
                            android:id="@+id/noExpensesTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Este vehículo no tiene ningún gasto asociado."
                            android:textAlignment="center"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="16sp" />

                        <Button
                            android:id="@+id/addExpenseButtonDirect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Agregar gasto"
                            app:backgroundTint="@color/button" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>